# Copy this file to .env for local configuration.
# GEMINI_API_KEY is optional; leave it blank to use rule-based fallback.
SERVER_PORT=8080

THREADPOOL_LIMITS_MAX_CONCURRENT_RUNS=5
THREADPOOL_LIMITS_MAX_TASKS_PER_RUN=500
THREADPOOL_LIMITS_MAX_TOTAL_TASKS=2000
THREADPOOL_LIMITS_MAX_WORKERS_PER_RUN=16
THREADPOOL_LIMITS_RUN_RETENTION_SECONDS=300

THREADPOOL_SSE_QUEUE_CAPACITY=1024
THREADPOOL_SSE_HEARTBEAT_SECONDS=15

THREADPOOL_RECOVERY_LLM_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent
THREADPOOL_RECOVERY_LLM_TIMEOUT_MS=3000
THREADPOOL_RECOVERY_LLM_MAX_CALLS=10
GEMINI_API_KEY=

LOGGING_LEVEL_EDU_OSLAB_THREADPOOL=INFO
JAVA_OPTS=
